# Local backend configuration. Copy to backend/.env and fill in real values.
# Do not commit backend/.env.

# JWT signing key (at least 32 bytes)
JWT_SECRET=

# Single-domain Docker deployment. Use a real public domain without https://.
# Compose requires APP_DOMAIN and passes only this value to the Caddy frontend.
APP_DOMAIN=

# Public browser key used at frontend build time. This is not the REST API key.
VITE_KAKAO_JS_KEY=

# Local PostgreSQL connection
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Server-side external API credentials
DATA_GO_KR_KEY=
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=

# Local HTTP bootRun may leave this unset (application.yml defaults to false).
# Docker Compose always forces it to true for HTTPS refresh cookies.
# APP_AUTH_REFRESH_COOKIE_SECURE=true
