# 로컬 백엔드 설정 예시입니다. backend/.env로 복사한 뒤 실제 값을 채웁니다.
# backend/.env는 Git에 커밋하지 않습니다.

# JWT 서명 키 (최소 32바이트)
JWT_SECRET=

# 단일 도메인 Docker 배포 설정입니다. https:// 없이 실제 도메인을 입력합니다.
# Compose는 이 값만 Caddy 프런트 컨테이너에 전달합니다.
APP_DOMAIN=

# 프런트 빌드에 쓰는 공개 브라우저 키입니다. REST API 키가 아닙니다.
VITE_KAKAO_JS_KEY=

# Supabase PostgreSQL 연결 정보
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# 서버 전용 외부 API 자격 증명
DATA_GO_KR_KEY=
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=

# 사진 저장소입니다. /uploads 폴더를 사용합니다.
# 경우에 따라 local or s3로 바꿉니다. AWS 접근 키는 이 파일에 넣지 않습니다.
APP_STORAGE_TYPE=local
# APP_STORAGE_LOCAL_DIR=./uploads
# s3사용 시 아래 값 사용
# AWS_REGION=ap-northeast-2
# APP_STORAGE_S3_BUCKET=

# 로컬 HTTP bootRun은 비워도 됩니다(application.yml 기본값 false).
# Docker Compose는 HTTPS refresh 쿠키를 위해 항상 true로 강제합니다.
# APP_AUTH_REFRESH_COOKIE_SECURE=true
